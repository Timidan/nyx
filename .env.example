# Nyx configuration — BOT Chain testnet (chain 968).
# Private keys are never stored in files. Export DEPLOYER_PRIVATE_KEY and
# AGENT_PRIVATE_KEY only in the shell that needs them (see docs/DEPLOY.md).

RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# Tokens and pool. Supply a verified V3 pool before deploying; the old shallow
# V2 pair is not an auction oracle.
BOT_V3_POOL=
# Factory that deployed BOT_V3_POOL. The oracle constructor round-trips
# getPool(token0, token1, fee) through it and reverts unless the answer is the
# pool address above. Read it from the pool with:
#   cast call $BOT_V3_POOL 'factory()(address)' --rpc-url $RPC_URL
# then confirm that factory returns the same pool before trusting either value.
BOT_V3_FACTORY=
BOUSDT=0xAfea2A5e0587615ceD6972e271E5bfe8622ebcA2
WBOT=0xD5452816194a3784dBa983426cCe7c122F4abd30
SWAP_ROUTER=0x07032d47A1b9f8460cBeE9dC17c1d3E438693929

# Deployment inputs. Caps use raw token units and are required.
OWNER_ADDRESS=
AGENT_ADDRESS=
#INITIAL_ALLOWED_TRADER=
#INITIAL_QUOTE_PROVIDER=
TWAP_WINDOW_SECONDS=900
MIN_V3_LIQUIDITY=
MAX_SPOT_TWAP_DEVIATION_BPS=500
MAX_CLEARING_DEVIATION_BPS=1000
CANCEL_DELAY_SECONDS=172800
WBOT_PER_ORDER_CAP=100000000000000000
WBOT_PER_BATCH_CAP=500000000000000000
WBOT_GLOBAL_CAP=1000000000000000000
BOUSDT_PER_ORDER_CAP=1000000
BOUSDT_PER_BATCH_CAP=5000000
BOUSDT_GLOBAL_CAP=10000000

# Fill these from the deployment receipt before the agent starts.
NYX_BATCH_AUCTION=
REFERENCE_ORACLE=
START_BLOCK=
AUCTION_RUNTIME_CODE_HASH=
DEPLOYER_ADDRESS=

# Agent runtime.
#AGENT_POLL_MS=5000
#AGENT_HOST=127.0.0.1
#AGENT_PORT=8787
#CORS_ORIGIN=http://localhost:5190
#AGENT_REQUIRE_API_BEARER_TOKEN=false
#AGENT_API_BEARER_TOKEN=
#QUOTE_PROVIDER_BEARER_TOKEN=
#AGENT_RATE_LIMIT_WINDOW_MS=60000
#AGENT_RATE_LIMIT_MAX_REQUESTS=60
#ORDER_STORE_PATH=.data/orders.json
#DRY_RUN=false

# Agent decision policy.
#DEPTH_MIN=4
#IMBALANCE_BPS=1500
#NOTIONAL_MAX_X18=1000000000000000000
#MAX_INTERVAL_SECONDS=60
#DEX_SPREAD_BPS=500

# Web (put these in web/.env.local or the hosting environment).
#VITE_CHAIN_ID=968
#VITE_RPC_URL=https://rpc.bohr.life
#VITE_EXPLORER_URL=https://scan.bohr.life
#VITE_AUCTION_ADDRESS=
#VITE_AGENT_API=http://localhost:8787
#VITE_REQUIRE_LIVE=false
#VITE_ORDER_TTL_SECONDS=900
#VITE_ACCESS_REQUEST_URL=https://example.com/canary-access
#VITE_QUOTE_PROVIDER_APPLY_URL=https://example.com/quote-provider-application
