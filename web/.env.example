# NyxBatchAuction address on BOT Chain testnet (chainId 968).
# Unset  -> the app runs on the built-in simulator ("Simulated data" badge).
# Set    -> live mode: viem reads against the contract + the agent HTTP API.
VITE_AUCTION_ADDRESS=

# Nyx agent local HTTP API. The agent defaults to port 8787
# (agent/src/config.ts: AGENT_PORT). Its CORS_ORIGIN must match the
# frontend dev origin (defaults to http://localhost:5173).
VITE_AGENT_API=http://localhost:8787
