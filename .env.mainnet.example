# BOT Chain mainnet canary template. Values below were read from chain 677 on
# 2026-08-08; verify them again immediately before deployment.
RPC_URL=https://rpc.botchain.ai
CHAIN_ID=677
WBOT=0xD5452816194a3784dBa983426cCe7c122F4abd30
BOUSDT=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
BOT_V3_POOL=0x64F418471a1A7932a190E10da5A8551dB5AbeC05
# The oracle constructor asks this factory to confirm BOT_V3_POOL is the pool it
# deployed for the pair and fee tier. Published in the BOT Chain integration
# guide; two shallower WBOT/USDT tiers exist, so the address alone is not enough.
BOT_V3_FACTORY=0x1C51c173323ec11BB4e3C4fD2314c225Dc4b5419
SWAP_ROUTER=0x07032d47A1b9f8460cBeE9dC17c1d3E438693929

# Required operator addresses. OWNER_ADDRESS should be controlled separately
# from the hot agent. The two canary wallets must be distinct.
OWNER_ADDRESS=
AGENT_ADDRESS=
INITIAL_ALLOWED_TRADER=
INITIAL_QUOTE_PROVIDER=

# Oracle. Active liquidity was about 1.85e19 at the first snapshot and 2.19e19
# on 2026-08-22. The 9e18 floor is fail-closed canary policy, not a permanent
# market risk judgment. Re-read it with scripts/preflight-mainnet.sh.
TWAP_WINDOW_SECONDS=900
MIN_V3_LIQUIDITY=9000000000000000000
MAX_SPOT_TWAP_DEVIATION_BPS=500
MAX_CLEARING_DEVIATION_BPS=1000
CANCEL_DELAY_SECONDS=172800

# Tiny canary caps in raw units: 0.1 / 0.5 / 1 WBOT and 1 / 5 / 10 USDT.
WBOT_PER_ORDER_CAP=100000000000000000
WBOT_PER_BATCH_CAP=500000000000000000
WBOT_GLOBAL_CAP=1000000000000000000
BOUSDT_PER_ORDER_CAP=1000000
BOUSDT_PER_BATCH_CAP=5000000
BOUSDT_GLOBAL_CAP=10000000

# Fill from the broadcast output and verification.
NYX_BATCH_AUCTION=
REFERENCE_ORACLE=
START_BLOCK=
AUCTION_RUNTIME_CODE_HASH=

# Agent runtime. Private keys remain shell-only.
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
AGENT_POLL_MS=5000
CORS_ORIGIN=https://example.com
AGENT_REQUIRE_API_BEARER_TOKEN=false
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX_REQUESTS=30
QUOTE_PROVIDER_BEARER_TOKEN=
ORDER_STORE_PATH=.data/orders.json
DRY_RUN=true
DEPTH_MIN=2
IMBALANCE_BPS=1500
NOTIONAL_MAX_X18=10000000000000000000
MAX_INTERVAL_SECONDS=60
DEX_SPREAD_BPS=500

# Web hosting environment.
VITE_CHAIN_ID=677
VITE_RPC_URL=https://rpc.botchain.ai
VITE_EXPLORER_URL=https://scan.botchain.ai
VITE_AUCTION_ADDRESS=
VITE_AGENT_API=https://agent.example.com
VITE_REQUIRE_LIVE=true
VITE_ORDER_TTL_SECONDS=900
VITE_ACCESS_REQUEST_URL=https://example.com/canary-access
VITE_QUOTE_PROVIDER_APPLY_URL=https://example.com/quote-provider-application
