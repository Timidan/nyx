# Nyx configuration — BOT Chain testnet (chain 968).
# Private keys are NEVER stored in files: export DEPLOYER_PRIVATE_KEY /
# AGENT_PRIVATE_KEY in the shell that runs a deployment or the agent
# (see docs/DEPLOY.md).

# Chain
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# Well-known addresses (BOT Chain testnet)
BOT_DEX_PAIR=0x4C7a5bE488491A76b2839AcCFc13d8Dd5276a5e0
BOUSDT=0xAfea2A5e0587615ceD6972e271E5bfe8622ebcA2
WBOT=0xD5452816194a3784dBa983426cCe7c122F4abd30
SWAP_ROUTER=0x07032d47A1b9f8460cBeE9dC17c1d3E438693929

# Deployment (filled in after `forge script` — see docs/DEPLOY.md)
NYX_BATCH_AUCTION=
DEPLOYER_ADDRESS=
AGENT_ADDRESS=

# Agent runtime (defaults shown; all optional)
#START_BLOCK=0                  # first block for event recovery scans
#AGENT_POLL_MS=5000             # perceive/decide cycle interval
#AGENT_HOST=127.0.0.1            # bind local API to loopback by default
#AGENT_PORT=8787                # local HTTP API port
#CORS_ORIGIN=http://localhost:5190
#AGENT_REQUIRE_API_BEARER_TOKEN=false  # set true for production/public agent API
#AGENT_API_BEARER_TOKEN=              # required when bearer-token enforcement is enabled
#AGENT_RATE_LIMIT_WINDOW_MS=60000
#AGENT_RATE_LIMIT_MAX_REQUESTS=60
#ORDER_STORE_PATH=.data/orders.json
#DRY_RUN=false                  # true = print decisions, send nothing

# Agent decision policy (defaults shown; all optional)
#DEPTH_MIN=4                    # reason 0: orders queued to trigger a round
#IMBALANCE_BPS=1500             # reason 1: max side imbalance to clear at midpoint
#NOTIONAL_MAX_X18=1000000000000000000   # reason 2: queued value threshold (token1 X18)
#MAX_INTERVAL_SECONDS=60        # reason 3: liveness backstop
#DEX_SPREAD_BPS=500             # reason 4: favorable-spread trigger
#MAX_CLEARING_DEVIATION_BPS=1000  # clearing price must stay within this of the DEX reference
