# Compose interpolation only. Keep the agent's actual secrets in the separate
# NYX_AGENT_ENV_FILE; this file contains paths and public routing values only.
NYX_AGENT_ENV_FILE=/home/agentops/nyx/nyx-agent.env
NYX_AGENT_AUTH_SNIPPET_HOST=/home/agentops/nyx/nyx-agent-auth.conf
NYX_STATE_DIRECTORY_HOST=/home/agentops/nyx/state
NYX_CORS_ORIGIN=https://nyx.timidan.xyz
NYX_PUBLIC_PROXY_NETWORK=public_proxy
NYX_AUCTION_ADDRESS=<existing-auction-address>
NYX_VITE_AGENT_API=/agent
NYX_REQUIRE_LIVE=true
