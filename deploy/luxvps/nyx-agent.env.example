# Copy this file to the target host as nyx-agent.env, set mode 600, and fill in
# the deployment-specific values through the approved secret-management path.
# Never commit the populated file or pass private-key/token values on a command
# line. Compose overrides the host binding, port, CORS origin, and state path.

# Mainnet values are in .env.mainnet.example. Verify every address with
# scripts/preflight-mainnet.sh before filling this file in.
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
BOUSDT=<bousdt-address>
WBOT=<wbot-address>
SWAP_ROUTER=<swap-router-address>
NYX_BATCH_AUCTION=<nyx-batch-auction-address>
AGENT_ADDRESS=<agent-wallet-address>
AGENT_PRIVATE_KEY=<agent-private-key>

# Startup verification refuses to run without these. The agent re-reads each one
# from chain and exits on any drift, so a placeholder here is a failed boot, not
# a silent misconfiguration.
REFERENCE_ORACLE=<reference-oracle-address>
BOT_V3_POOL=<canonical-v3-pool-address>
BOT_V3_FACTORY=<v3-factory-address>
AUCTION_RUNTIME_CODE_HASH=<keccak-of-deployed-runtime>

# The auction's deployment block. Zero is rejected: it would make event recovery
# walk the whole chain.
START_BLOCK=<auction-deployment-block>
AGENT_POLL_MS=5000
AGENT_REQUIRE_API_BEARER_TOKEN=true
AGENT_API_BEARER_TOKEN=<random-bearer-token>
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX_REQUESTS=60
DRY_RUN=false

DEPTH_MIN=4
IMBALANCE_BPS=1500
NOTIONAL_MAX_X18=1000000000000000000
MAX_INTERVAL_SECONDS=60
DEX_SPREAD_BPS=500
MAX_CLEARING_DEVIATION_BPS=1000
